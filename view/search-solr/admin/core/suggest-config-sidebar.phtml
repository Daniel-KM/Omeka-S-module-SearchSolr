<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \SearchSolr\Stdlib\SolrCore $solrCore
 * @var bool|null $hasSuggestTxt Null when the schema is unreachable.
 *
 * Configuration of the suggest field, loaded into the core page sidebar.
 */

$plugins = $this->getHelperPluginManager();
$escape = $plugins->get('escapeHtml');
$translate = $plugins->get('translate');
$hyperlink = $plugins->get('hyperlink');
?>

<div id="sidebar-confirm">
    <h3><?= $escape($translate('Suggest configuration')) ?></h3>
    <p class="explanation"><?= $translate('Configure the "suggest_txt" field used for autocompletion. This field aggregates copyFields from _txt mapped fields.') ?></p>
    <?php if ($hasSuggestTxt === true): ?>
    <p class="explanation"><strong><?= $translate('Current status: suggest_txt exists.') ?></strong></p>
    <?php elseif ($hasSuggestTxt === false): ?>
    <p class="explanation"><strong><?= $translate('Current status: suggest_txt does not exist.') ?></strong></p>
    <?php else: ?>
    <p class="explanation"><strong><?= $translate('Current status: unknown (the Solr schema is unreachable).') ?></strong></p>
    <?php endif; ?>
    <p class="explanation"><?= $translate('By default, "suggest_txt" uses a language-neutral folded type (lowercase + ASCII folding, preserveOriginal), so suggestions are case- and diacritics-insensitive. Use the "diacritics-sensitive" variants to keep type "text_general" instead.') ?></p>
    <ul>
        <li><?= $hyperlink($translate($hasSuggestTxt ? 'Recreate suggest_txt' : 'Create suggest_txt'), $solrCore->adminUrl('create-suggest-field'), [
            'class' => 'button',
            'title' => $translate('Create the "suggest_txt" field with copyFields from short-value _txt fields for autocompletion.')]) ?></li>
        <li><?= $hyperlink($translate($hasSuggestTxt ? 'Recreate suggest_txt (with long texts)' : 'Create suggest_txt (with long texts)'), $solrCore->adminUrl('create-suggest-field') . '?include_long_texts=1', [
            'class' => 'button',
            'title' => $translate('Create "suggest_txt" including long-value properties (OCR, descriptions, etc.).')]) ?></li>
        <li><?= $hyperlink($translate($hasSuggestTxt ? 'Recreate suggest_txt (diacritics-sensitive)' : 'Create suggest_txt (diacritics-sensitive)'), $solrCore->adminUrl('create-suggest-field') . '?keep_diacritics=1', [
            'class' => 'button',
            'title' => $translate('Create "suggest_txt" with type "text_general" (case-insensitive only).')]) ?></li>
        <li><?= $hyperlink($translate($hasSuggestTxt ? 'Recreate suggest_txt (with long texts, diacritics-sensitive)' : 'Create suggest_txt (with long texts, diacritics-sensitive)'), $solrCore->adminUrl('create-suggest-field') . '?include_long_texts=1&keep_diacritics=1', [
            'class' => 'button',
            'title' => $translate('Create "suggest_txt" including long-value properties with type "text_general".')]) ?></li>
    </ul>
</div>
