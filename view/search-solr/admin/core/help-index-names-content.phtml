<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 *
 * Body of the help about the index names, shared by the details of the map form
 * and the dialog of the core page.
 */

$plugins = $this->getHelperPluginManager();
$escape = $plugins->get('escapeHtml');
$translate = $plugins->get('translate');
?>

<p>
    <?= $escape($translate('The indices of the default Solr configuration work with names and suffixes matching type:')) ?>
</p>
<ul>
    <li><?= $escape($translate('"_t" and "_txt" are used to store words individually.')) ?></li>
    <li><?= $escape($translate('"_s" and "_ss" are used to store whole string.')) ?></li>
    <li><?= $escape($translate('"_i" and "_is" are used to store integers.')) ?></li>
    <li><?= $escape($translate('"_dt" and "_dts" are used to store dates.')) ?></li>
    <li><?= $escape($translate('"_ancestor_path" and "_descendent_path" are used to store structures.')) ?></li>
</ul>
<p>
    <?= $escape($translate('The choice of type depends on what you need for a metadata:')) ?>
</p>
<ul>
    <li><?= $escape($translate('For global searches, indices should be "_t" and "_txt".')) ?></li>
    <li><?= $escape($translate('For simple filters and facets, indices should be a multiple whole values ("_ss", "_is" and "_dts").')) ?></li>
    <li><?= $escape($translate('For sort, it should be a single value ("_s", "_i" and "_dt"); "_fold_s" sorts case- and diacritics-insensitively, like the database collation.')) ?></li>
    <li><?= $escape($translate('For bounce links, it should be multiple values formatted for linking ("_link_ss").')) ?></li>
    <li><?= $escape($translate('For main autocompletion ("à-la-google search"), "_txt" should be used. There is a default field "suggest_txt" that groups "_txt" fields.')) ?></li>
    <li><?= $escape($translate('For autocompletion in filters, you may use "_ss" for short values and "_txt" for long ones. Here, autocompletion in filters is generally useless for long values.')) ?></li>
    <li><?= $escape($translate('"_ancestor_path" and "_descendent_path" are generally used for search and facets, generally with a thesaurus, a classification scheme, or geographic names.')) ?></li>
</ul>
<p>
    <?= $escape($translate('Other indices are available for complex cases. Solr should be configured first if more types are needed.')) ?>
</p>
