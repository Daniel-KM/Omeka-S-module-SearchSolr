<?php
// Warn when another core points to the same Solr url: two cores on the same
// physical core share one index and schema, so one overwrites the other and a
// reindex wipes both.
$thisUrl = $solrCore->clientUrlAdmin();
$sharedWith = [];
foreach ($this->api()->search('search_engines')->getContent() as $otherEngine) {
    if ($otherEngine->id() === $solrCore->id() || $otherEngine->engineAdapterName() !== 'solarium') {
        continue;
    }
    $otherCore = $otherEngine->engineAdapter() ? $otherEngine->engineAdapter()->getSolrCore() : null;
    if ($otherCore && $otherCore->clientUrlAdmin() === $thisUrl) {
        $sharedWith[] = $otherCore->name();
    }
}
?>
<?php if ($sharedWith): ?>
<p class="messages"><span class="message warning"><?= $escape(sprintf($translate('This core points to the same Solr url as: %s. They share one physical index and schema, so one overwrites the other and a reindex wipes both. Give each core its own physical Solr core (a distinct core name in the url).'), implode(', ', $sharedWith))) ?></span></p>
<?php endif; ?>

<?php
// Determine active resource type filter and view from query string.
$activeResourceFilter = $_GET['resource_type'] ?? '';
// The simple list is the default view.
$isSimpleView = ($_GET['view'] ?? '') !== 'full';
$maps = $solrCore->mapsByFieldName();
// Collect all resource types used in maps.
$usedResourceTypes = [];
foreach ($maps as $fieldMaps) {
    foreach ($fieldMaps as $map) {
        $usedResourceTypes[$map->resourceName()] = true;
    }
}
// The real names of the resource types, keyed by the name used in the maps, in
// display order.
$resourceTypeLabels = [
    'generic' => $translate('Generic'),
    'resources' => $translate('Resources (mixed)'),
    'item_sets' => $translate('Item sets'),
    'items' => $translate('Items'),
    'media' => $translate('Media'),
    'annotations' => $translate('Annotations'),
    'digital_objects' => $translate('Digital objects'),
    'concepts' => $translate('Concepts'),
];
$usedResourceTypes = array_replace(
    array_intersect_key($resourceTypeLabels, $usedResourceTypes),
    array_diff_key($usedResourceTypes, $resourceTypeLabels)
);
// Simple list: one row per distinct source, the indexes as edit links.
$mapsBySource = [];
foreach ($maps as $fieldMaps) {
    foreach ($fieldMaps as $map) {
        $mapsBySource[$map->source()][] = $map;
    }
}
ksort($mapsBySource);
// Group the sources by vocabulary; the non-property indexes (id, is_public,
// resource_name…) go into the group "Metadata".
$vocabLabels = [];
foreach ($this->api()->search('vocabularies')->getContent() as $vocab) {
    $vocabLabels[$vocab->prefix()] = $vocab->label();
}
$metadataLabel = $translate('Metadata');
$mapsByVocab = [];
$sourceVocabs = [];
foreach ($mapsBySource as $source => $sourceMaps) {
    $prefix = strpos($source, ':') !== false ? strtok($source, ':') : '';
    // A composed source ("owner/o:id") is a metadata index too.
    $vocabLabel = $prefix !== '' && strpos($source, '/') === false && isset($vocabLabels[$prefix])
        ? $vocabLabels[$prefix]
        : $metadataLabel;
    $mapsByVocab[$vocabLabel][$source] = $sourceMaps;
    $sourceVocabs[$source] = $vocabLabel;
}
// The group "Metadata" first, then the vocabularies alphabetically.
uksort($mapsByVocab, fn ($a, $b) => ($a === $metadataLabel ? 0 : 1) <=> ($b === $metadataLabel ? 0 : 1) ?: strcasecmp($a, $b));
// The real usages of each index (facets, filters, sorts, query, suggesters,
// settings), displayed as grey info icons next to the index name.
$fieldUsages = $solrCore->listFieldUsages();
$usageIcons = [
    'required' => 'fas fa-lock',
    'system' => 'fas fa-cogs',
    'manual' => 'fas fa-hand-paper',
    'language' => 'fas fa-globe',
    'facet' => 'fas fa-layer-group',
    'filter' => 'fas fa-filter',
    'sort' => 'fas fa-sort-amount-down',
    'query' => 'fas fa-sliders-h',
    'suggester' => 'fas fa-keyboard',
    'settings' => 'fas fa-cog',
];
$usageLabels = [
    'required' => $translate('Required'),
    'system' => $translate('System'),
    'manual' => $translate('Manual'),
    'language' => $translate('Language'),
    'facet' => $translate('Facet'),
    'filter' => $translate('Filter'),
    'sort' => $translate('Sort'),
    'query' => $translate('Query'),
    'suggester' => $translate('Suggester'),
    'settings' => $translate('Settings'),
];
// One sentence by usage; the places are listed when there are some.
$usageSentences = [
    'required' => $translate('Required for Solr'),
    'system' => $translate('Needed by Advanced Search or the modules'),
    'manual' => $translate('Created or edited by hand: never removed by the sync'),
    'language' => $translate('Language index for the sites of the locale: %s'),
    'facet' => $translate('Used in facets: %s'),
    'filter' => $translate('Used in filters: %s'),
    'sort' => $translate('Used in sorts: %s'),
    'query' => $translate('Used in queries: %s'),
    'suggester' => $translate('Used in suggesters: %s'),
    'settings' => $translate('Used in settings: %s'),
];
$usageTitle = function (string $usage, array $places) use ($usageSentences): string {
    return strpos($usageSentences[$usage], '%s') === false
        ? $usageSentences[$usage]
        : sprintf($usageSentences[$usage], implode(', ', $places));
};
$usageIconsHtml = function (string $fieldName) use ($fieldUsages, $usageIcons, $usageLabels, $usageTitle, $escapeAttr): string {
    $html = '';
    foreach ($fieldUsages[$fieldName] ?? [] as $usage => $places) {
        $html .= sprintf(
            '<span class="map-usage o-icon- %1$s" role="img" aria-label="%2$s" title="%3$s"></span>',
            $usageIcons[$usage],
            $escapeAttr($usageLabels[$usage]),
            $escapeAttr($usageTitle($usage, $places))
        );
    }
    return $html === '' ? '' : '<span class="map-usages">' . $html . '</span>';
};
