                <td class="map-index-links">
                    <?php foreach ($sourceMaps as $map):
                        $mapSettings = $map->settings();
                        $fieldName = $map->fieldName();
                        // The manual flag is not a usage of the index by a
                        // config: it is a protection against the sync, so it
                        // has its own line instead of being merged with them.
                        $usageSummary = [];
                        $manualSummary = '';
                        foreach ($fieldUsages[$fieldName] ?? [] as $usage => $places) {
                            if ($usage === 'manual') {
                                $manualSummary = $usageTitle($usage, $places);
