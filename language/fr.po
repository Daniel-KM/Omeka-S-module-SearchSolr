msgid "Solr fields for suggestions"
msgstr "Champs Solr pour les suggestions"

#: Module.php:313
msgid ""
"The unified field \"suggest_txt\" is the most efficient option: single "
"suggester, short-value fields only. \"All fields\" creates one suggester per "
"text/string field (including long values). Individual indexes can be grouped."
msgstr ""
"Le champ unifié « suggest_txt » est l’option la plus efficace : un seul "
"suggéreur, uniquement les champs à valeurs courtes. « Tous les champs » crée "
"un suggéreur par champ texte/chaîne (y compris les valeurs longues). Les "
"index individuels peuvent être regroupés."

#: Module.php:320
msgid "Select fields…"
msgstr "Choisir des champs…"

#: Module.php:327
msgid "Algorithm for suggestions"
msgstr "Algorithme pour les suggestions"

#: Module.php:329
msgid "AnalyzingInfixLookup (matches anywhere)"
msgstr "AnalyzingInfixLookup (correspond à n’importe quel endroit)"

#: Module.php:330
msgid "BlendedInfixLookup (prefix weighted)"
msgstr "BlendedInfixLookup (préfixe pondéré)"

#: Module.php:331
msgid "AnalyzingLookup (prefix only)"
