#: view/search-solr/admin/core/suggest-config-sidebar.phtml:23
msgid ""
"The field \"suggest_txt\" feeds the autocompletion from the mapped text "
"fields."
msgstr ""
"Le champ « suggest_txt » est utilisé pour l’autocomplétion à partir des "
"champs texte."

#: view/search-solr/admin/core/suggest-config-sidebar.phtml:25
msgid "Current status: suggest_txt exists."
msgstr "Statut actuel : suggest_txt existe."

#: view/search-solr/admin/core/suggest-config-sidebar.phtml:27
msgid "Current status: suggest_txt does not exist."
msgstr "Statut actuel : suggest_txt n’existe pas."

#: view/search-solr/admin/core/suggest-config-sidebar.phtml:34
msgid "Long texts"
msgstr "Textes longs"

#: view/search-solr/admin/core/suggest-config-sidebar.phtml:35
msgid ""
"Include the long-value properties (OCR, descriptions…) in the suggestions."
msgstr ""
"Inclure les propriétés ayant des valeurs longues (OCR, descriptions, etc.) "
"dans les suggestions."

#: view/search-solr/admin/core/suggest-config-sidebar.phtml:39
msgid "Without"
msgstr "Sans"

#: view/search-solr/admin/core/suggest-config-sidebar.phtml:43
msgid "With"
msgstr "Avec"

#: view/search-solr/admin/core/suggest-config-sidebar.phtml:49
msgid "Diacritics"
msgstr "Diacritiques"

#: view/search-solr/admin/core/suggest-config-sidebar.phtml:50
msgid ""
"Insensitive: \"cafe\" suggests \"café\". Sensitive: the accents must match."
msgstr ""
"Insensible : « cafe » renvoie à « café ». Sensible : les accents doivent "
"correspondre."

#: view/search-solr/admin/core/suggest-config-sidebar.phtml:54
msgid "Insensitive"
msgstr "Insensible"

#: view/search-solr/admin/core/suggest-config-sidebar.phtml:58
